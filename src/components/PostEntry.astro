---
import { Image } from 'astro:assets';
import { formatDate, getExcerpt, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
const { title, pubDate, category, image } = post.data;
---
<li class="entry">
  <article>
    <div class="text">
      <p class="meta"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {category}</p>
      <Heading class="title"><a href={postUrl(post)}>{title}</a></Heading>
      <p class="excerpt">{getExcerpt(post)}</p>
    </div>
    {image && <Image src={image.url} alt="" widths={[320, 640, 960]} sizes="(min-width: 64rem) 16rem, (min-width: 40rem) 10rem, calc(100vw - 4rem)" />}
  </article>
</li>

<style>
  .entry {
    position: relative;
    padding-block: 1.25rem;
  }

  /* Dot on the timeline */
  .entry::before {
    content: '';
    position: absolute;
    top: 1.95rem;
    left: calc(-1.25rem - 6px);
    width: 10px;
    height: 10px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--base);
  }

  /* The padding is cancelled by the negative margin, so the text stays put and the box grows outwards */
  article {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: -0.75rem;
    padding: 0.75rem;
    border-radius: 0.75rem;
    transition: background-color 150ms ease;
  }

  /* Hover box: the darker panel colour with a hint of the entry's timeline colour, so it suits every theme */
  article:focus-within,
  article:hover {
    background: color-mix(in srgb, var(--accent) 8%, var(--mantle));
  }

  @media (prefers-reduced-motion: reduce) {
    article {
      transition: none;
    }
  }

  .meta {
    margin: 0 0 0.25rem;
  }

  .title {
    font-size: 1.3rem;
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole entry is the link */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  article:hover .title a {
    color: var(--accent);
  }

  .excerpt {
    display: -webkit-box;
    max-width: var(--reading);
    margin: 0.5rem 0 0;
    overflow: hidden;
    color: var(--subtext1);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  img {
    order: -1;
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  @media (min-width: 40rem) {
    article {
      grid-template-columns: minmax(0, 1fr) 10rem;
      gap: 1.5rem;
      align-items: start;
    }

    img {
      order: 0;
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 64rem) {
    article {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 2.5rem;
    }

    .title {
      font-size: 1.5rem;
    }
  }
</style>

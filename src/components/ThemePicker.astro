---
import Icon from './Icon.astro';
import { PRIDE_THEMES, YEAR_THEMES } from '../lib/themes';

// Every theme is in the page; theme.ts shows the flavours, or the pride flags in pride mode
const themes = [...YEAR_THEMES.map((theme) => ({ ...theme, season: 'year' })), ...PRIDE_THEMES.map((theme) => ({ ...theme, season: 'pride' }))];
---
<div class="theme-picker" data-theme-picker>
  <button type="button" class="icon-button" aria-label="Change theme" aria-expanded="false" aria-controls="theme-menu" data-theme-toggle>
    <Icon name="palette" />
  </button>
  <ul id="theme-menu" class="menu" hidden>
    {themes.map((theme) => (
      <li hidden={theme.season === 'pride'}>
        <button type="button" data-theme-option={theme.id} data-season={theme.season} data-base={theme.base} aria-pressed="false">
          <span class="swatch" style={`background:${theme.flag ? `linear-gradient(var(--flag-${theme.id}))` : theme.base};color:${theme.ink}`}><Icon name={theme.icon} /></span>
          {theme.label}
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  import { applyTheme, chooseTheme, currentTheme, themeOptions } from '../scripts/theme';

  const picker = document.querySelector<HTMLElement>('[data-theme-picker]')!;
  const toggle = picker.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const menu = picker.querySelector<HTMLUListElement>('.menu')!;

  function setOpen(open: boolean) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    const options = themeOptions();
    if (open) (options.find((o) => o.getAttribute('aria-pressed') === 'true') ?? options[0]).focus();
  }

  applyTheme(currentTheme());

  toggle.addEventListener('click', () => setOpen(menu.hidden));

  for (const option of picker.querySelectorAll<HTMLButtonElement>('[data-theme-option]')) {
    option.addEventListener('click', () => {
      chooseTheme(option.dataset.themeOption!);
      setOpen(false);
      toggle.focus();
    });
  }

  // Close on Escape or a click elsewhere; arrow keys move through the themes
  picker.addEventListener('keydown', (event) => {
    if (menu.hidden) return;
    if (event.key === 'Escape') {
      setOpen(false);
      toggle.focus();
    } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const options = themeOptions();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      const index = options.indexOf(document.activeElement as HTMLButtonElement);
      options[(index + step + options.length) % options.length].focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!menu.hidden && !picker.contains(event.target as Node)) setOpen(false);
  });
</script>

<style>
  .theme-picker {
    position: relative;
  }

  [data-theme-toggle] {
    color: var(--mauve);
  }

  .menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    min-width: 12rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: var(--mantle);
    border: 2px solid var(--surface1);
    border-radius: 0.75rem;
  }

  .menu[hidden],
  .menu li[hidden] {
    display: none;
  }

  .menu button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: var(--tap);
    padding: 0.25rem 0.6rem 0.25rem 0.25rem;
    background: none;
    border: 0;
    border-radius: 0.5rem;
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }

  .menu button:hover {
    background: var(--surface0);
  }

  .menu button[aria-pressed='true'] {
    background: var(--surface0);
    font-weight: 700;
  }

  .swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--surface1);
    border-radius: 50%;
  }

  .swatch :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>

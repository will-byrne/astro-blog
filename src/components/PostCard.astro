---
import { formatDate, getExcerpt, postUrl, type Post } from '../lib/posts';

const { post } = Astro.props as { post: Post };
const { title, pubDate, category, image } = post.data;
---
<article class="card-wrapper card">
  <a href={postUrl(post)} class="post-preview row g-0 flex-md-row-reverse">
    {image && (
      <div class="col-md-5">
        <div class="preview-img"><img src={image.url} alt={image.alt} loading="lazy" /></div>
      </div>
    )}
    <div class={image ? 'col-md-7' : 'col-md-12'}>
      <div class="card-body d-flex flex-column">
        <h1 class="card-title my-2 mt-md-0">{title}</h1>
        <div class="card-text content mt-0 mb-3"><p>{getExcerpt(post)}</p></div>
        <div class="post-meta flex-grow-1 d-flex align-items-end">
          <div class="me-auto">
            <i class="far fa-calendar fa-fw me-1"></i>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            <i class="far fa-folder-open fa-fw me-1"></i>
            <span class="categories">{category}</span>
          </div>
        </div>
      </div>
    </div>
  </a>
</article>

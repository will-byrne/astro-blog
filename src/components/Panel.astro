---
import TrendingTags from './TrendingTags.astro';
import { getPosts, getRecentlyUpdated, postUrl } from '../lib/posts';

const recent = getRecentlyUpdated(await getPosts());
---
<aside aria-label="Panel" id="panel-wrapper" class="col-xl-3 ps-2 mb-5 text-muted">
  <div class="access">
    <section id="access-lastmod">
      <h2 class="panel-heading">Recently Updated</h2>
      <ul class="content list-unstyled ps-0 pb-1 ms-1 mt-2">
        {recent.map((post) => (
          <li class="text-truncate lh-lg"><a href={postUrl(post)}>{post.data.title}</a></li>
        ))}
      </ul>
    </section>
    <TrendingTags />
  </div>
  <slot />
</aside>

---
import TocList, { type TocNode } from './TocList.astro';

interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;

// Nest each heading under the nearest shallower one above it
const roots: TocNode[] = [];
const stack: TocNode[] = [];
for (const heading of headings.filter((h) => h.depth <= 4)) {
  const node = { ...heading, children: [] };
  while (stack.length > 0 && stack[stack.length - 1].depth >= node.depth) stack.pop();
  (stack[stack.length - 1]?.children ?? roots).push(node);
  stack.push(node);
}
---

{roots.length > 0 && (
  <section id="toc-wrapper" class="ps-0 pe-4">
    <h2 class="panel-heading ps-3 pt-2 mb-2">Contents</h2>
    <nav id="toc">
      <TocList nodes={roots} />
    </nav>
  </section>
)}

<script>
  const tocLinks = document.querySelectorAll('.toc-link');
  const headings = document.querySelectorAll('article .content :is(h1, h2, h3, h4)[id]');

  // Shows only the active entry, its ancestors and its direct children
  function setActive(link: Element) {
    tocLinks.forEach((other) => {
      other.classList.remove('is-active-link');
      other.parentElement?.classList.remove('is-active-li');
    });
    document.querySelectorAll('#toc .is-collapsible').forEach((list) => list.classList.add('is-collapsed'));

    link.classList.add('is-active-link');
    link.parentElement?.classList.add('is-active-li');
    link.parentElement?.querySelector(':scope > ul')?.classList.remove('is-collapsed');
    for (let list = link.closest('ul'); list; list = list.parentElement?.closest('ul') ?? null) {
      list.classList.remove('is-collapsed');
    }
  }

  if (tocLinks.length > 0 && headings.length > 0) {
    setActive(tocLinks[0]);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const link = document.querySelector(`.toc-link[href="#${CSS.escape(entry.target.id)}"]`);
        if (link) setActive(link);
      });
    }, { rootMargin: '-80px 0px -80% 0px', threshold: 0 });

    headings.forEach((heading) => observer.observe(heading));
  }
</script>

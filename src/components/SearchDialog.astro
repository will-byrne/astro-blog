---
import Icon from './Icon.astro';
---
<dialog id="search" aria-label="Search posts">
  <div class="bar">
    <input id="search-input" type="search" placeholder="Search posts" aria-label="Search posts" autocomplete="off" />
    <button type="button" class="icon-button" data-search-close aria-label="Close search"><Icon name="close" /></button>
  </div>
  <p id="search-status" class="meta" role="status"></p>
  <ul id="search-results" class="cycle"></ul>
</dialog>

<style is:global>
  #search {
    width: min(100% - 1.5rem, 44rem);
    max-width: none;
    max-height: calc(100dvh - 1.5rem);
    margin: 0.75rem auto auto;
    padding: 0.75rem;
    background: var(--mantle);
    border: 2px solid var(--surface1);
    border-radius: 0.75rem;
    color: var(--text);
  }

  #search::backdrop {
    background: color-mix(in srgb, var(--crust) 80%, transparent);
  }

  #search .bar {
    display: flex;
    gap: 0.5rem;
  }

  #search-input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    padding-inline: 0.75rem;
    background: var(--base);
    border: 1px solid var(--surface2);
    border-radius: 0.5rem;
    color: var(--text);
    font: inherit;
  }

  #search-input::placeholder {
    color: var(--subtext1);
    opacity: 1;
  }

  #search-status {
    margin: 0.5rem 0 0;
    padding-inline: 0.25rem;
  }

  #search-status:empty {
    display: none;
  }

  #search-results {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #search-results a {
    display: block;
    padding: 0.75rem 0.5rem;
    border-radius: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }

  #search-results a:hover {
    background: var(--surface0);
  }

  #search-results strong {
    display: block;
    color: var(--accent);
    line-height: 1.3;
  }

  #search-results span {
    display: block;
    margin-top: 0.25rem;
    color: var(--subtext1);
    font-size: 1rem;
    line-height: 1.5;
  }
</style>

---
export interface TocNode {
  depth: number;
  slug: string;
  text: string;
  children: TocNode[];
}

interface Props {
  nodes: TocNode[];
  nested?: boolean;
}

const { nodes, nested = false } = Astro.props;
---
<ul class:list={['toc-list', { 'is-collapsible': nested, 'is-collapsed': nested }]}>
  {nodes.map((node) => (
    <li class="toc-list-item">
      <a href={`#${node.slug}`} class={`toc-link node-name--H${node.depth}`}>{node.text}</a>
      {node.children.length > 0 && <Astro.self nodes={node.children} nested />}
    </li>
  ))}
</ul>

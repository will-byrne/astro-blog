---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostEntry from './PostEntry.astro';
import type { Term } from '../lib/posts';

interface Props {
  term: Term;
  kind: 'Tag' | 'Category';
}

const { term, kind } = Astro.props;
const count = `${term.posts.length} ${term.posts.length === 1 ? 'post' : 'posts'}`;
const parent = kind === 'Tag' ? { href: '/tags/', label: 'All tags' } : { href: '/categories/', label: 'All categories' };
---
<BaseLayout pageTitle={term.label} description={`${count} filed under ${term.label}.`}>
  <h1 class="page-title">{term.label}</h1>
  <p class="page-intro">{kind} · {count} · <a href={parent.href}>{parent.label}</a></p>
  <ol class="timeline cycle">
    {term.posts.map((post) => <PostEntry post={post} headingLevel="h2" />)}
  </ol>
</BaseLayout>

---
import { getPosts, getTrendingTags } from '../lib/posts';

const tags = getTrendingTags(await getPosts());
---
<section>
  <h2 class="panel-heading">Trending Tags</h2>
  <div class="d-flex flex-wrap mt-3 mb-1 me-3">
    {tags.map(({ slug, label }) => <a class="post-tag btn btn-outline-primary" href={`/tags/${slug}/`}>{label}</a>)}
  </div>
</section>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicNav from '../../components/TopicNav.astro';
import { getCategories, getPosts } from '../../lib/posts';

const categories = getCategories(await getPosts());
---

<BaseLayout pageTitle="Categories" ogType="article">
  <h1 class="page-title">Categories</h1>
  <TopicNav />
  <ul class="cycle">
    {categories.map(({ slug, label, posts }) => (
      <li>
        <a href={`/categories/${slug}/`}>
          <span>{label}</span>
          <span class="count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    border-top: 1px solid var(--surface0);
    color: var(--accent);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 3rem;
    }
  }

  .count {
    flex: none;
    color: var(--subtext1);
    font-size: 1rem;
  }
</style>

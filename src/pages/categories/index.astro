---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategories, getPosts } from '../../lib/posts';

const categories = getCategories(await getPosts());
---

<BaseLayout pageTitle="Categories" ogType="article">
  <article class="px-1">
    <h1 class="dynamic-title">Categories</h1>
    <div class="content">
      {categories.map(({ slug, label, posts }) => (
        <div class="card categories">
          <div class="card-header d-flex justify-content-between hide-border-bottom">
            <span class="ms-2">
              <i class="far fa-folder fa-fw"></i>
              <a href={`/categories/${slug}/`} class="mx-2">{label}</a>
              <span class="text-muted small font-weight-light">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
            </span>
            <span class="category-trigger hide-border-bottom disabled">
              <i class="fas fa-fw fa-angle-right"></i>
            </span>
          </div>
        </div>
      ))}
    </div>
  </article>
</BaseLayout>

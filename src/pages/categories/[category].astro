---
import TermPage from '../../components/TermPage.astro';
import { getCategories, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const categories = getCategories(await getPosts());
  return categories.map((term) => ({ params: { category: term.slug }, props: { term } }));
}

const { term } = Astro.props;
---
<TermPage term={term} kind="Category" />

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout pageTitle="Tags" ogType="article">
  <article class="px-1">
    <h1 class="dynamic-title">Tags</h1>
    <div class="content">
      <div id="tags" class="d-flex flex-wrap mx-xl-2">
        {tags.map(({ slug, label, posts }) => (
          <div>
            <a class="tag" href={`/tags/${slug}/`}>{label}<span class="text-muted">{posts.length}</span></a>
          </div>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

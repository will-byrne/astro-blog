---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicNav from '../../components/TopicNav.astro';
import TermChart from '../../components/TermChart.astro';
import { getPosts, getTags } from '../../lib/posts';

const tags = getTags(await getPosts());
---

<BaseLayout pageTitle="Tags" ogType="article">
  <h1 class="page-title">Tags</h1>
  <TopicNav />
  <TermChart noun="tags" terms={tags} basePath="/tags/" title="Posts per tag" minPosts={2} />
  <ul class="cycle" data-term-list>
    {tags.map(({ slug, label, posts }) => (
      <li data-key={slug}><a href={`/tags/${slug}/`}>{label} <span>{posts.length}</span></a></li>
    ))}
  </ul>
</BaseLayout>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    padding-inline: 0.9rem;
    background: var(--mantle);
    border-radius: 0.5rem;
    color: var(--accent);
    text-decoration: none;
  }

  /* .picked: its entry in the chart is hovered */
  a:hover,
  .picked a {
    background: var(--surface0);
  }

  .picked a {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  span {
    color: var(--subtext1);
    font-size: 1rem;
  }
</style>

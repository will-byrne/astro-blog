---
import TermPage from '../../components/TermPage.astro';
import { getPosts, getTags } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = getTags(await getPosts());
  return tags.map((term) => ({ params: { tag: term.slug }, props: { term } }));
}

const { term } = Astro.props;
---
<TermPage term={term} kind="Tag" />

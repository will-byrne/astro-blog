---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, postUrl, type Post } from '../lib/posts';

const years = new Map<number, Post[]>();
for (const post of await getPosts()) {
  const year = post.data.pubDate.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), post]);
}

const day = (date: Date) => String(date.getUTCDate()).padStart(2, '0');
const month = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
---

<BaseLayout pageTitle="Archives" ogType="article">
  <article class="px-1">
    <h1 class="dynamic-title">Archives</h1>
    <div class="content">
      <div id="archives" class="pl-xl-3">
        {[...years].map(([year, posts]) => (
          <>
            <time class="year lead d-block">{year}</time>
            <ul class="list-unstyled">
              {posts.map((post) => (
                <li>
                  <span class="date day">{day(post.data.pubDate)}</span>
                  <span class="date month small text-muted ms-1">{month(post.data.pubDate)}</span>
                  <a href={postUrl(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

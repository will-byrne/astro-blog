---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildSections } from '../lib/gallery';
import { formatDate } from '../lib/posts';

// Each folder in src/assets/gallery is a section; see src/lib/gallery.ts for section.json
const files = import.meta.glob<ImageMetadata>('../assets/gallery/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
  import: 'default',
});
const configs = import.meta.glob('../assets/gallery/*/section.json', { eager: true, import: 'default' });
const sections = buildSections(files, configs);
---

<BaseLayout pageTitle="Gallery" ogType="article">
  <h1 class="page-title">Gallery</h1>
  <p class="page-intro">Things I have made: art, drawings and photos.</p>

  {sections.length > 1 && (
    <nav class="sections" aria-label="Gallery sections">
      {sections.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)}
    </nav>
  )}

  <div class="cycle">
    {sections.map(({ id, title, description, images }) => (
      <section aria-labelledby={id}>
        <h2 id={id}>{title}</h2>
        {description && <p class="description">{description}</p>}
        <div class="grid">
          {images.map(({ src, alt, date }) => (
            <figure>
              <Image src={src} alt={alt} widths={[320, 640, 960, 1600]} sizes="(min-width: 75rem) 18rem, (min-width: 48rem) 33vw, 50vw" data-zoomable />
              {date && <figcaption class="meta"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></figcaption>}
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .sections {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin: -1.5rem 0 2rem;
  }

  .sections a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  section + section {
    margin-top: 3rem;
  }

  h2 {
    color: var(--accent);
    scroll-margin-top: 1rem;
  }

  .description {
    max-width: var(--reading);
    margin: 0.5rem 0 0;
    color: var(--subtext1);
  }

  .grid {
    margin-top: 1rem;
    columns: 2;
    column-gap: 0.75rem;
  }

  figure {
    margin: 0 0 0.75rem;
    break-inside: avoid;
  }

  img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }

  figcaption {
    margin-top: 0.25rem;
    font-size: 0.9rem;
  }

  @media (min-width: 48rem) {
    .grid {
      columns: 3;
    }
  }

  @media (min-width: 75rem) {
    .grid {
      columns: 4;
    }
  }
</style>

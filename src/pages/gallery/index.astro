---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGalleries } from '../../lib/gallery-content';
import { previewImages } from '../../lib/gallery';

const galleries = getGalleries();
const count = (n: number) => `${n} ${n === 1 ? 'image' : 'images'}`;
---

<BaseLayout pageTitle="Gallery" ogType="website">
  <h1 class="page-title">Gallery</h1>
  <p class="page-intro">Things I have made: art, drawings and photos.</p>

  <ul class="cards cycle">
    {galleries.map((gallery) => (
      <li>
        <article class="card">
          <Image src={gallery.cover.src} alt="" widths={[400, 800, 1200]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2.5rem)" class="cover" />
          <div class="text">
            <h2><a href={`/gallery/${gallery.id}/`}>{gallery.title}</a></h2>
            <p class="meta">{count(gallery.images.length)}</p>
            {gallery.description && <p class="description">{gallery.description}</p>}
          </div>
          {previewImages(gallery).length > 0 && (
            <div class="thumbs" aria-hidden="true">
              {previewImages(gallery).map((image) => <Image src={image.src} alt="" widths={[96, 192]} sizes="5rem" />)}
            </div>
          )}
        </article>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The whole card is the link; the box matches the hover on journal entries */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.75rem;
    background: var(--mantle);
    border: 2px solid var(--surface0);
    border-radius: 0.75rem;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .card:hover,
  .card:focus-within {
    background: color-mix(in srgb, var(--accent) 8%, var(--mantle));
    border-color: var(--accent);
  }

  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .text {
    flex: 1;
    padding: 0.75rem 0.25rem 0;
  }

  h2 {
    font-size: 1.4rem;
  }

  /* Text colour, not the accent, so the title stays readable on the card in every theme */
  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h2 a,
  .card:focus-within h2 a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .meta {
    margin: 0.25rem 0 0;
  }

  .description {
    margin: 0.5rem 0 0;
    color: var(--subtext1);
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .thumbs img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0.375rem;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>

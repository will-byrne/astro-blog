---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGalleries } from '../../lib/gallery-content';
import { findGallery, type GallerySection } from '../../lib/gallery';
import { formatDate, getPosts, postUrl, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const galleries = getGalleries();
  const posts = await getPosts();
  return galleries.map((gallery) => ({
    params: { gallery: gallery.id },
    props: {
      gallery,
      others: galleries.filter((other) => other.id !== gallery.id),
      // Posts with `gallery:` naming this one in their frontmatter, newest first
      posts: posts.filter((post) => post.data.gallery && findGallery(galleries, post.data.gallery) === gallery),
    },
  }));
}

interface Props {
  gallery: GallerySection;
  others: GallerySection[];
  posts: Post[];
}

const { gallery, others, posts } = Astro.props;
const count = (n: number) => `${n} ${n === 1 ? 'image' : 'images'}`;
---

<BaseLayout pageTitle={`${gallery.title} gallery`} description={gallery.description} image={gallery.cover.src} imageAlt={gallery.cover.alt}>
  <p class="back"><a href="/gallery/">← All galleries</a></p>
  <h1 class="page-title">{gallery.title}</h1>
  {gallery.description && <p class="description">{gallery.description}</p>}
  <p class="meta count">{count(gallery.images.length)}</p>

  {posts.length > 0 && (
    <section class="posts" aria-labelledby="posts-heading">
      <h2 id="posts-heading">{posts.length === 1 ? 'Read the post' : 'Read the posts'}</h2>
      <ul>
        {posts.map((post) => (
          <li>
            <a href={postUrl(post)}>{post.data.title}</a>
            <p class="meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class:list={["grid", gallery.layout]}>
    {gallery.images.map(({ src, alt, date, caption }) => (
      <figure>
        <Image src={src} alt={alt} widths={[320, 640, 960, 1600]} sizes="(min-width: 75rem) 18rem, (min-width: 48rem) 33vw, 50vw" data-zoomable />
        {(caption || date) && (
          <figcaption>
            {caption && <span class="caption">{caption}</span>}
            {date && <time class="meta" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  {others.length > 0 && (
    <nav class="others" aria-label="Other galleries">
      <h2>More galleries</h2>
      <ul>
        {others.map((other) => <li><a href={`/gallery/${other.id}/`}>{other.title}</a> <span class="meta">{count(other.images.length)}</span></li>)}
      </ul>
    </nav>
  )}
</BaseLayout>

<style>
  .back {
    margin: 2rem 0 0;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }

  .back + .page-title {
    margin-top: 0.5rem;
  }

  .description {
    max-width: var(--reading);
    margin: 0.75rem 0 0;
    color: var(--subtext1);
  }

  .count {
    margin: 0.5rem 0 2rem;
  }

  .posts {
    margin: 0 0 2rem;
  }

  .posts h2 {
    color: var(--peach);
    font-size: 1.25rem;
  }

  .posts ul {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    padding-block: 0.25rem;
  }

  .posts a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }

  .posts p {
    margin: 0;
  }

  .grid {
    columns: 2;
    column-gap: 0.75rem;
  }

  /* Reads across in order, row by row, for images that are all one shape */
  .grid.rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: start;
  }

  .grid.rows figure {
    margin: 0;
  }

  figure {
    margin: 0 0 0.75rem;
    break-inside: avoid;
  }

  img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.375rem;
    font-size: 0.9rem;
  }

  .caption {
    color: var(--subtext1);
  }

  .others {
    margin-top: 3rem;
  }

  .others h2 {
    color: var(--teal);
    font-size: 1.3rem;
  }

  .others ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  @media (min-width: 48rem) {
    .grid {
      columns: 3;
    }

    .grid.rows {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 75rem) {
    .grid {
      columns: 4;
    }

    .grid.rows {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

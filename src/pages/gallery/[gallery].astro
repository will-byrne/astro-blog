---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGalleries } from '../../lib/gallery-content';
import type { GallerySection } from '../../lib/gallery';
import { formatDate } from '../../lib/posts';

export function getStaticPaths() {
  const galleries = getGalleries();
  return galleries.map((gallery) => ({
    params: { gallery: gallery.id },
    props: { gallery, others: galleries.filter((other) => other.id !== gallery.id) },
  }));
}

interface Props {
  gallery: GallerySection;
  others: GallerySection[];
}

const { gallery, others } = Astro.props;
const count = (n: number) => `${n} ${n === 1 ? 'image' : 'images'}`;
---

<BaseLayout pageTitle={`${gallery.title} gallery`} description={gallery.description} image={gallery.cover.src}>
  <p class="back"><a href="/gallery/">← All galleries</a></p>
  <h1 class="page-title">{gallery.title}</h1>
  {gallery.description && <p class="description">{gallery.description}</p>}
  <p class="meta count">{count(gallery.images.length)}</p>

  <div class="grid">
    {gallery.images.map(({ src, alt, date, caption }) => (
      <figure>
        <Image src={src} alt={alt} widths={[320, 640, 960, 1600]} sizes="(min-width: 75rem) 18rem, (min-width: 48rem) 33vw, 50vw" data-zoomable />
        {(caption || date) && (
          <figcaption>
            {caption && <span class="caption">{caption}</span>}
            {date && <time class="meta" datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
          </figcaption>
        )}
      </figure>
    ))}
  </div>

  {others.length > 0 && (
    <nav class="others" aria-label="Other galleries">
      <h2>More galleries</h2>
      <ul>
        {others.map((other) => <li><a href={`/gallery/${other.id}/`}>{other.title}</a> <span class="meta">{count(other.images.length)}</span></li>)}
      </ul>
    </nav>
  )}
</BaseLayout>

<style>
  .back {
    margin: 2rem 0 0;
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
  }

  .back + .page-title {
    margin-top: 0.5rem;
  }

  .description {
    max-width: var(--reading);
    margin: 0.75rem 0 0;
    color: var(--subtext1);
  }

  .count {
    margin: 0.5rem 0 2rem;
  }

  .grid {
    columns: 2;
    column-gap: 0.75rem;
  }

  figure {
    margin: 0 0 0.75rem;
    break-inside: avoid;
  }

  img {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.375rem;
    font-size: 0.9rem;
  }

  .caption {
    color: var(--subtext1);
  }

  .others {
    margin-top: 3rem;
  }

  .others h2 {
    color: var(--teal);
    font-size: 1.3rem;
  }

  .others ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  @media (min-width: 48rem) {
    .grid {
      columns: 3;
    }
  }

  @media (min-width: 75rem) {
    .grid {
      columns: 4;
    }
  }
</style>

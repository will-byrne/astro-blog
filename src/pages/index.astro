---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, POSTS_PER_PAGE, SITE_TITLE } from '../lib/posts';

const allPosts = await getPosts();
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
---
<BaseLayout pageTitle={SITE_TITLE} crumbs={[{ label: 'Home' }]}>
  <PostList posts={allPosts.slice(0, POSTS_PER_PAGE)} page={1} totalPages={totalPages} />
</BaseLayout>

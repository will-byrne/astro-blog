---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPosts, POSTS_PER_PAGE } from '../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPosts();
  const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
  // Page 1 is the home page
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
        page,
        totalPages,
      },
    };
  });
}

const { posts, page, totalPages } = Astro.props;
---
<BaseLayout pageTitle={`Journal, page ${page}`}>
  <h1 class="page-title">Journal</h1>
  <p class="page-intro">Older entries.</p>
  <PostList posts={posts} page={page} totalPages={totalPages} />
</BaseLayout>

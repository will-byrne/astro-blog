---
import { getImage } from 'astro:assets';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';
import '../styles/fun.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/posts';
import { PRIDE_DEFAULT_THEME, PRIDE_MODE_KEY, PRIDE_STORAGE_KEY, PRIDE_THEMES, STORAGE_KEY, YEAR_THEMES } from '../lib/themes';
// Made from scripts/og-default.html; used for link previews when a page has no image of its own
import defaultSocialImage from '../assets/images/og-default.png';

interface Props {
  pageTitle: string;
  description?: string;
  image?: ImageMetadata;
  /** Describes the image for people who cannot see it in a link preview */
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** A ready-made 1200x630 PNG for link previews, e.g. a post's card from /posts/<id>/card.png; used instead of `image` */
  socialCard?: { url: string; alt: string };
}

const { pageTitle, description = SITE_DESCRIPTION, image, imageAlt, ogType = 'website', socialCard } = Astro.props;
const title = pageTitle === SITE_TITLE ? SITE_TITLE : `${pageTitle} | ${SITE_TITLE}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Cropped to the 1.91:1 shape link previews use, up to 1200x630. Images are never enlarged, so a small
// image gets the largest crop of that shape it can fill, and the tags below always give the real size.
async function cropForPreview(source: ImageMetadata) {
  const width = Math.floor(Math.min(1200, source.width, (source.height * 1200) / 630));
  const height = Math.round((width * 630) / 1200);
  const { src } = await getImage({ src: source, width, height, fit: 'cover', format: 'jpeg' });
  return { src, width, height, type: 'image/jpeg' };
}
const social = socialCard
  ? { src: socialCard.url, width: 1200, height: 630, type: 'image/png', alt: socialCard.alt }
  : { ...(await cropForPreview(image ?? defaultSocialImage)), alt: image ? (imageAlt ?? '') : `${SITE_TITLE}: ${SITE_DESCRIPTION}` };
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#24273a" />
    <script is:inline define:vars={{ yearThemes: YEAR_THEMES.map((t) => t.id), prideThemes: PRIDE_THEMES.map((t) => t.id), prideDefault: PRIDE_DEFAULT_THEME, storageKey: STORAGE_KEY, prideStorageKey: PRIDE_STORAGE_KEY, prideModeKey: PRIDE_MODE_KEY }}>
      // Apply the saved theme, and any fun modes, before the page paints. In pride mode, on all June and turned on by
      // the rainbow in the footer the rest of the year, the picker offers pride flags instead; see src/lib/themes.ts
      const root = document.documentElement;
      // Blocked storage throws as soon as it is touched, so it is only named inside the try
      const read = (storage, key) => {
        try {
          return window[storage].getItem(key);
        } catch {
          return null;
        }
      };
      const june = new Date().getMonth() === 5;
      const pride = june || read('localStorage', prideModeKey) === 'on';
      const theme = read('localStorage', pride ? prideStorageKey : storageKey);
      if (pride) {
        root.dataset.pride = '';
        root.dataset.theme = prideDefault;
      }
      if ((pride ? prideThemes : yearThemes).includes(theme)) root.dataset.theme = theme;
      // Night vision (n) and unicorn mode (the Konami code) last for the visit; see fun.js
      if (read('sessionStorage', 'night') === 'on') root.dataset.night = '';
      if (read('sessionStorage', 'unicorn') === 'on') root.dataset.unicorn = '';
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
    <link rel="shortcut icon" href="/assets/img/favicons/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={new URL(social.src, Astro.site)} />
    <meta property="og:image:type" content={social.type} />
    <meta property="og:image:width" content={String(social.width)} />
    <meta property="og:image:height" content={String(social.height)} />
    {social.alt && <meta property="og:image:alt" content={social.alt} />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-box">
      <div class="pride-note" aria-hidden="true"><span>Happy Pride 🌈</span></div>
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
    <button type="button" id="back-to-top" class="icon-button" aria-label="Back to top" hidden><Icon name="up" /></button>
    <SearchDialog />
    <dialog id="lightbox" aria-label="Enlarged image">
      <img alt="" />
      <div class="lightbox-drawing" hidden></div>
      <button type="button" class="icon-button" aria-label="Close image"><Icon name="close" /></button>
    </dialog>
    <p id="fun-status" class="sr-only" aria-live="polite"></p>
    <script>
      import '../scripts/site.js';
      import '../scripts/fun.js';
    </script>
    <style>
      #back-to-top {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 5;
        background: var(--surface0);
        border-radius: 50%;
        color: var(--mauve);
      }

      #back-to-top[hidden] {
        display: none;
      }
    </style>
  </body>
</html>

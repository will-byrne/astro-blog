---
import { getImage } from 'astro:assets';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../lib/posts';
// Made from scripts/og-default.html; used for link previews when a page has no image of its own
import defaultSocialImage from '../assets/images/og-default.png';

interface Props {
  pageTitle: string;
  description?: string;
  image?: ImageMetadata;
  /** Describes the image for people who cannot see it in a link preview */
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const { pageTitle, description = SITE_DESCRIPTION, image, imageAlt, ogType = 'website' } = Astro.props;
const title = pageTitle === SITE_TITLE ? SITE_TITLE : `${pageTitle} | ${SITE_TITLE}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Cropped to the 1.91:1 shape link previews use, up to 1200x630. Images are never enlarged, so a small
// image gets the largest crop of that shape it can fill, and the tags below always give the real size.
const socialSource = image ?? defaultSocialImage;
const socialWidth = Math.floor(Math.min(1200, socialSource.width, (socialSource.height * 1200) / 630));
const socialHeight = Math.round((socialWidth * 630) / 1200);
const socialImage = await getImage({ src: socialSource, width: socialWidth, height: socialHeight, fit: 'cover', format: 'jpeg' });
const socialImageAlt = image ? (imageAlt ?? '') : `${SITE_TITLE}: ${SITE_DESCRIPTION}`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#24273a" />
    <script is:inline>
      // Apply the saved flavour before the page paints
      try {
        const theme = localStorage.getItem('theme');
        if (['latte', 'frappe', 'macchiato', 'mocha'].includes(theme)) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
    <link rel="shortcut icon" href="/assets/img/favicons/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(socialWidth)} />
    <meta property="og:image:height" content={String(socialHeight)} />
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="page-box">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
    <button type="button" id="back-to-top" class="icon-button" aria-label="Back to top" hidden><Icon name="up" /></button>
    <SearchDialog />
    <dialog id="lightbox" aria-label="Enlarged image">
      <img alt="" />
      <button type="button" class="icon-button" aria-label="Close image"><Icon name="close" /></button>
    </dialog>
    <script>
      import '../scripts/site.js';
    </script>
    <style>
      #back-to-top {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 5;
        background: var(--surface0);
        border-radius: 50%;
        color: var(--mauve);
      }

      #back-to-top[hidden] {
        display: none;
      }
    </style>
  </body>
</html>

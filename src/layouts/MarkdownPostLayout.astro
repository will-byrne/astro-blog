---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { AUTHOR_URL, SITE_TITLE, formatDate, getExcerpt, getPosts, getReadingTime, getRelatedPosts, getWordCount, postUrl, slugify, type Post } from "../lib/posts";

const { post, headings } = Astro.props as { post: Post; headings: { depth: number; slug: string; text: string }[] };
const { title, pubDate, updated, image, author, category, tags } = post.data;

const posts = await getPosts();
const index = posts.findIndex((other) => other.id === post.id);
const newer = posts[index - 1];
const older = posts[index + 1];
const related = getRelatedPosts(post, posts);

const encodedUrl = encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href);
const encodedTitle = encodeURIComponent(`${title} - ${SITE_TITLE}`);
const shareLinks = [
  { label: 'Twitter', icon: 'fa-twitter', href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { label: 'Facebook', icon: 'fa-facebook-square', href: `https://www.facebook.com/sharer/sharer.php?title=${encodedTitle}&u=${encodedUrl}` },
  { label: 'Telegram', icon: 'fa-telegram', href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}` },
];
---

<BaseLayout pageTitle={title} description={getExcerpt(post)} image={image?.url} ogType="article" topbarTitle="Post">
  <article class="px-1">
    <header>
      <h1 data-toc-skip>{title}</h1>
      <div class="post-meta text-muted">
        <span>Posted <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></span>
        {updated && <span> Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        {image && (
          <div class="mt-3 mb-3">
            <a href={image.url} class="popup img-link preview-img"><img src={image.url} alt={image.alt} width="1200" height="630" loading="lazy" /></a>
            {image.alt && <figcaption class="text-center pt-2 pb-2">{image.alt}</figcaption>}
          </div>
        )}
        <div class="d-flex justify-content-between">
          <span>By <em><a href={AUTHOR_URL}>{author}</a></em></span>
          <span class="readtime" title={`${getWordCount(post)} words`}><em>{getReadingTime(post)} min</em> read</span>
        </div>
      </div>
    </header>

    <div class="content">
      <slot />
    </div>

    <div class="post-tail-wrapper text-muted">
      <div class="post-meta mb-3">
        <i class="far fa-folder-open fa-fw me-1"></i>
        <a href={`/categories/${slugify(category)}/`}>{category}</a>
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          <i class="fa fa-tags fa-fw me-1"></i>
          {tags.map((tag) => <a href={`/tags/${slugify(tag)}/`} class="post-tag no-text-decoration">{tag}</a>)}
        </div>
      )}
      <div class="post-tail-bottom d-flex justify-content-between align-items-center mt-5 pb-2">
        <div class="license-wrapper">
          This post is licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> by the author.
        </div>
        <div class="share-wrapper d-flex align-items-center">
          <span class="share-label text-muted">Share</span>
          <span class="share-icons">
            {shareLinks.map(({ label, icon, href }) => (
              <a href={href} target="_blank" rel="noopener" title={label} aria-label={label}><i class={`fa-fw fab ${icon}`}></i></a>
            ))}
            <button id="copy-link" aria-label="Copy link" class="btn small" title="Copy link">
              <i class="fa-fw fas fa-link pe-none fs-6"></i>
            </button>
          </span>
        </div>
      </div>
    </div>
  </article>

  <TableOfContents slot="panel" headings={headings} />

  <Fragment slot="tail">
    {related.length > 0 && (
      <aside id="related-posts" aria-labelledby="related-label">
        <h3 class="mb-4" id="related-label">Further Reading</h3>
        <nav class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
          {related.map((other) => (
            <article class="col">
              <a href={postUrl(other)} class="post-preview card h-100">
                <div class="card-body">
                  <time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time>
                  <h4 class="pt-0 my-2">{other.data.title}</h4>
                  <div class="text-muted"><p>{getExcerpt(other)}</p></div>
                </div>
              </a>
            </article>
          ))}
        </nav>
      </aside>
    )}
    <nav class="post-navigation d-flex justify-content-between" aria-label="Post Navigation">
      {older
        ? <a href={postUrl(older)} class="btn btn-outline-primary" aria-label="Older"><p>{older.data.title}</p></a>
        : <div class="btn btn-outline-primary disabled" aria-label="Older"><p>-</p></div>}
      {newer
        ? <a href={postUrl(newer)} class="btn btn-outline-primary" aria-label="Newer"><p>{newer.data.title}</p></a>
        : <div class="btn btn-outline-primary disabled" aria-label="Newer"><p>-</p></div>}
    </nav>
  </Fragment>
</BaseLayout>

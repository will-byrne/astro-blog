---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { formatDate, getExcerpt, getPosts, getReadingTime, getRelatedPosts, postUrl, slugify, type Post } from "../lib/posts";

const { post, headings } = Astro.props as { post: Post; headings: { depth: number; slug: string; text: string }[] };
const { title, pubDate, updated, image, category, tags } = post.data;

const posts = await getPosts();
const index = posts.findIndex((other) => other.id === post.id);
const newer = posts[index - 1];
const older = posts[index + 1];
const related = getRelatedPosts(post, posts);
---

<BaseLayout pageTitle={title} description={getExcerpt(post)} image={image?.url} ogType="article">
  <article class="post">
    <header>
      <p class="meta"><a href={`/categories/${slugify(category)}/`}>{category}</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        · {getReadingTime(post)} min read
        {updated && <><br />Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
      </p>
      {image && (
        <figure>
          <Image src={image.url} alt={image.alt} widths={[640, 960, 1280, 1600]} sizes="min(47rem, calc(100vw - 2.5rem))" loading="eager" fetchpriority="high" data-zoomable />
          {image.alt && <figcaption class="meta">{image.alt}</figcaption>}
        </figure>
      )}
    </header>

    <TableOfContents headings={headings} />

    <div class="body">
      <div class="prose">
        <slot />
      </div>

      <footer>
        {tags.length > 0 && (
          <ul class="tags cycle" aria-label="Tags">
            {tags.map((tag) => <li><a href={`/tags/${slugify(tag)}/`}>{tag}</a></li>)}
          </ul>
        )}
        <button type="button" id="share" class="share"><Icon name="share" /><span>Share</span></button>

        <nav class="post-nav" aria-label="More posts">
          {older && <a href={postUrl(older)} rel="prev"><span class="meta">Older</span>{older.data.title}</a>}
          {newer && <a href={postUrl(newer)} rel="next" class="next"><span class="meta">Newer</span>{newer.data.title}</a>}
        </nav>

        {related.length > 0 && (
          <section class="related">
            <h2>Related posts</h2>
            <ul>
              {related.map((other) => (
                <li>
                  <a href={postUrl(other)}>{other.data.title}</a>
                  <p class="meta"><time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time></p>
                </li>
              ))}
            </ul>
          </section>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'toc' 'body';
    max-width: var(--reading);
    margin-inline: auto;
  }

  header {
    grid-area: head;
    padding-top: 2.5rem;
  }

  header p {
    margin: 0;
  }

  header .meta a {
    color: var(--pink);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  h1 {
    color: var(--mauve);
    margin-block: 0.25rem 0.75rem;
    font-size: clamp(2rem, 7vw, 2.75rem);
  }

  figure {
    margin: 1.5rem 0 0;
  }

  figure img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.5rem;
    overflow-wrap: break-word;
  }

  .body {
    grid-area: body;
    min-width: 0;
    padding-top: 1.5rem;
  }

  /* Headings in posts should not push the first line of text down */
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--surface0);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 0.9rem;
    background: var(--mantle);
    border-radius: 0.5rem;
    color: var(--accent);
    font-size: 1rem;
    text-decoration: none;
  }

  .tags a:hover {
    background: var(--surface0);
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    padding-inline: 0.9rem;
    background: var(--surface0);
    border: 0;
    border-radius: 0.5rem;
    color: var(--teal);
    cursor: pointer;
  }

  .share:hover {
    background: var(--surface1);
  }

  .post-nav {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .post-nav a {
    display: block;
    padding: 0.75rem 1rem;
    background: var(--mantle);
    border-radius: 0.75rem;
    color: var(--text);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .post-nav a:hover {
    color: var(--pink);
  }

  .post-nav .meta {
    display: block;
    font-weight: 400;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related h2 {
    color: var(--peach);
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related li {
    padding-block: 0.5rem;
  }

  .related p {
    margin: 0;
  }

  @media (min-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr 1fr;
    }

    .post-nav .next {
      grid-column: 2;
    }
  }

  /* The reading column, with the contents list beside it */
  @media (min-width: 75rem) {
    .post {
      grid-template-columns: minmax(0, var(--reading)) minmax(0, 1fr);
      grid-template-areas:
        'head toc'
        'body toc';
      column-gap: 4rem;
      max-width: none;
    }
  }
</style>

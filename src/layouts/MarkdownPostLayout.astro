---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SeriesNav from "../components/SeriesNav.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { findGallery, previewImages } from "../lib/gallery";
import { getGalleries } from "../lib/gallery-content";
import { SITE_TITLE, formatDate, getBacklinks, getExcerpt, getPosts, getReadingTime, getRelatedPosts, getSeries, postUrl, slugify, type Post } from "../lib/posts";

const { post, headings } = Astro.props as { post: Post; headings: { depth: number; slug: string; text: string }[] };
const { title, pubDate, updated, image, category, tags } = post.data;

const posts = await getPosts();
const index = posts.findIndex((other) => other.id === post.id);
const newer = posts[index - 1];
const older = posts[index + 1];
const backlinks = getBacklinks(post, posts);
// Posts already listed as linking here are left out of related posts, so none shows twice
const related = getRelatedPosts(post, posts.filter((other) => !backlinks.includes(other)));
const series = getSeries(post, posts);
const nextPart = series?.posts[series.index + 1];
// When the next part is also the next newer post, the Newer link says so instead of showing it twice
const nextPartIsNewer = nextPart !== undefined && nextPart.id === newer?.id;
// Fails the build if the post names a gallery that does not exist
const gallery = post.data.gallery ? findGallery(getGalleries(), post.data.gallery) : undefined;
const galleryThumbs = gallery ? [gallery.cover, ...previewImages(gallery, 3)] : [];
const imageCount = (n: number) => `${n} ${n === 1 ? "image" : "images"}`;
---

<BaseLayout
  pageTitle={title}
  description={getExcerpt(post)}
  ogType="article"
  socialCard={{
    url: `${postUrl(post)}card.png`,
    alt: image?.alt ? `${title}, with the post's cover image: ${image.alt}` : `${title}, a post on ${SITE_TITLE}`,
  }}
>
  <div class="reading-progress" aria-hidden="true"><div></div></div>
  <article class="post">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        · {getReadingTime(post)} min read
        {updated && <><br />Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
      </p>
      <dl class="terms">
        <div>
          <dt class="meta">Category</dt>
          <dd><a class="category" href={`/categories/${slugify(category)}/`}>{category}</a></dd>
        </div>
        {tags.length > 0 && (
          <div>
            <dt class="meta">Tags</dt>
            <dd>
              <ul class="tags cycle">
                {tags.map((tag) => <li><a href={`/tags/${slugify(tag)}/`}>{tag}</a></li>)}
              </ul>
            </dd>
          </div>
        )}
      </dl>
      {image && (
        <figure>
          <Image src={image.url} alt={image.alt} widths={[640, 960, 1280, 1600]} sizes="min(47rem, calc(100vw - 2.5rem))" loading="eager" fetchpriority="high" data-zoomable />
          {image.alt && <figcaption class="meta">{image.alt}</figcaption>}
        </figure>
      )}
    </header>

    <TableOfContents headings={headings} />

    <div class="body">
      {series && <SeriesNav series={series} />}

      <div class="prose">
        <slot />
      </div>

      {gallery && (
        <aside class="gallery-link" aria-label="Gallery">
          <div class="gallery-text">
            <p class="meta">From the gallery</p>
            <p class="gallery-title"><a href={`/gallery/${gallery.id}/`}>{gallery.title}</a></p>
            <p class="meta">{imageCount(gallery.images.length)}</p>
          </div>
          <div class="gallery-thumbs" aria-hidden="true">
            {galleryThumbs.map((thumb) => <Image src={thumb.src} alt="" widths={[96, 192]} sizes="5rem" />)}
          </div>
        </aside>
      )}

      <footer>
        {nextPart && !nextPartIsNewer && (
          <a class="next-part" href={postUrl(nextPart)}>
            <span class="meta">Next in {series!.name}</span>
            {nextPart.data.title}
          </a>
        )}

        <button type="button" id="share" class="share"><Icon name="share" /><span>Share</span></button>

        <nav class="post-nav" aria-label="More posts">
          {older && <a href={postUrl(older)} rel="prev"><span class="meta">Older</span>{older.data.title}</a>}
          {newer && <a href={postUrl(newer)} rel="next" class="next"><span class="meta">{nextPartIsNewer ? `Newer, and next in ${series!.name}` : "Newer"}</span>{newer.data.title}</a>}
        </nav>

        {backlinks.length > 0 && (
          <section class="related backlinks">
            <h2>Posts that link here</h2>
            <ul>
              {backlinks.map((other) => (
                <li>
                  <a href={postUrl(other)}>{other.data.title}</a>
                  <p class="meta"><time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time> · {getReadingTime(other)} min read</p>
                  <p class="excerpt">{getExcerpt(other)}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {related.length > 0 && (
          <section class="related">
            <h2>Related posts</h2>
            <ul>
              {related.map((other) => (
                <li>
                  <a href={postUrl(other)}>{other.data.title}</a>
                  <p class="meta"><time datetime={other.data.pubDate.toISOString()}>{formatDate(other.data.pubDate)}</time> · {getReadingTime(other)} min read</p>
                  <p class="excerpt">{getExcerpt(other)}</p>
                </li>
              ))}
            </ul>
          </section>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>

<script>
  // The bar at the top fills as the post is read: empty at the start of the text, full at its end
  const bar = document.querySelector<HTMLElement>('.reading-progress > div');
  const text = document.querySelector<HTMLElement>('.post .prose');
  if (bar && text) {
    let queued = false;
    const update = () => {
      queued = false;
      const { top, height } = text.getBoundingClientRect();
      const scrollable = height - window.innerHeight;
      const done = scrollable > 0 ? -top / scrollable : top + height <= window.innerHeight ? 1 : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, done))})`;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: 4px;
    pointer-events: none;
  }

  .reading-progress > div {
    height: 100%;
    background: var(--mauve);
    transform: scaleX(0);
    transform-origin: left;
  }

  .next-part {
    display: block;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    background: var(--mantle);
    border: 2px solid var(--surface1);
    border-radius: 0.75rem;
    color: var(--text);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .next-part:hover {
    border-color: var(--mauve);
  }

  .next-part .meta {
    display: block;
    font-weight: 400;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'toc' 'body';
    max-width: var(--reading);
    margin-inline: auto;
  }

  header {
    grid-area: head;
    padding-top: 2.5rem;
  }

  header p {
    margin: 0;
  }

  h1 {
    color: var(--mauve);
    margin-block: 0 0.75rem;
    font-size: clamp(2rem, 7vw, 2.75rem);
  }

  figure {
    margin: 1.5rem 0 0;
  }

  figure img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.5rem;
    overflow-wrap: break-word;
  }

  .body {
    grid-area: body;
    min-width: 0;
    padding-top: 1.5rem;
  }

  /* Headings in posts should not push the first line of text down */
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  /* The whole box is the link, like the cards on /gallery/ */
  .gallery-link {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-top: 2.5rem;
    padding: 0.75rem 1rem;
    background: var(--mantle);
    border: 2px solid var(--surface0);
    border-radius: 0.75rem;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .gallery-link:hover,
  .gallery-link:focus-within {
    background: color-mix(in srgb, var(--accent) 8%, var(--mantle));
    border-color: var(--accent);
  }

  .gallery-link p {
    margin: 0;
  }

  .gallery-title {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .gallery-title a {
    color: var(--text);
    text-decoration: none;
  }

  .gallery-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .gallery-link:hover .gallery-title a,
  .gallery-link:focus-within .gallery-title a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .gallery-thumbs img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 0.375rem;
    object-fit: cover;
  }

  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--surface0);
  }

  /* Category and tags: a label on its own line, then the links, so each group reads on its own */
  .terms {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
  }

  .terms dt {
    margin-bottom: 0.25rem;
  }

  .terms dd {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .terms a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 0.9rem;
    background: var(--mantle);
    border-radius: 0.5rem;
    color: var(--accent);
    font-size: 1rem;
    text-decoration: none;
  }

  /* Every category looks the same, so new categories need no styling */
  .terms .category {
    border: 2px solid var(--surface1);
    color: var(--text);
    font-weight: 700;
  }

  .terms a:hover {
    background: var(--surface0);
  }

  @media (min-width: 40rem) {
    .terms {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1.5rem;
    }
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    padding-inline: 0.9rem;
    background: var(--surface0);
    border: 0;
    border-radius: 0.5rem;
    color: var(--teal);
    cursor: pointer;
  }

  .share:hover {
    background: var(--surface1);
  }

  .post-nav {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .post-nav a {
    display: block;
    padding: 0.75rem 1rem;
    background: var(--mantle);
    border-radius: 0.75rem;
    color: var(--text);
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
  }

  .post-nav a:hover {
    color: var(--pink);
  }

  .post-nav .meta {
    display: block;
    font-weight: 400;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related h2 {
    color: var(--peach);
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .related ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related li {
    padding-block: 0.5rem;
  }

  .related p {
    margin: 0;
  }

  .related .excerpt {
    display: -webkit-box;
    margin-top: 0.25rem;
    overflow: hidden;
    color: var(--subtext1);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-link {
      transition: none;
    }
  }

  @media (min-width: 40rem) {
    .gallery-link {
      grid-template-columns: 1fr 20rem;
      align-items: center;
    }

    .post-nav {
      grid-template-columns: 1fr 1fr;
    }

    .post-nav .next {
      grid-column: 2;
    }
  }

  /* The reading column, with the contents list beside it */
  @media (min-width: 75rem) {
    .post {
      grid-template-columns: minmax(0, var(--reading)) minmax(0, 1fr);
      grid-template-areas:
        'head toc'
        'body toc';
      column-gap: 4rem;
      max-width: none;
    }
  }
</style>
